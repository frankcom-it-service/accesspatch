# Runtime configuration for bounded evidence collection and GPT-5.6 Structured
# Outputs reasoning. Evidence and repair plans are schema validated; deterministic
# reasoner policy validation and sanitized model auditing are implemented.
# gpt-5.6-sol is the full model ID; gpt-5.6 is its current alias.
# Deterministic isolated patch generation and repaired replay exist for the two
# controlled Phase 1 templates. Complete fallback handling, retained patch
# application to a user-selected repository, rollback, and broad repository
# support remain NOT YET IMPLEMENTED. A deterministic canonical Proof Bundle
# generator and static report are committed for the controlled Phase 1 evidence;
# the independently reviewed generated bundle remains ignored and untracked, not a
# curated judge sample. The real API key remains outside this repository.
# OPENAI_API_KEY must never be committed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Optional future local demo target; format and use are NOT YET IMPLEMENTED.
ACCESSPATCH_DEMO_BASE_URL=
