# Phase 1B runtime configuration for the bounded evidence collector and GPT-5.6
# repair reasoner. Evidence and repair plans are schema validated; deterministic
# policy validation and sanitized audit logging are implemented.
# gpt-5.6-sol is the full model ID; gpt-5.6 is its current alias.
# Patch generation or application, repaired replay, complete fallback workflow,
# reporting, and Proof Bundle generation are NOT YET IMPLEMENTED. The real key
# remains outside this repository. OPENAI_API_KEY must never be committed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Optional future local demo target; format and use are NOT YET IMPLEMENTED.
ACCESSPATCH_DEMO_BASE_URL=
